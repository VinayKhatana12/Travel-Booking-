# ── Wanderly server configuration ────────────────────────────────────────────
# Copy this file to .env and fill in real values:  cp .env.example .env

PORT=5000
NODE_ENV=development

# PostgreSQL connection string.
# Create the database + seed data with:  npm run db:setup
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/wanderly

# Secret used to sign JWTs. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# How long login sessions last.
JWT_EXPIRES_IN=7d

# Allowed browser origin (comma-separated list is supported).
CLIENT_ORIGIN=http://localhost:5173

# ── Amadeus Flight Search (optional) ─────────────────────────────────────────
# Without these keys the /api/flights route serves generated sample data.
# Get free test keys at https://developers.amadeus.com (Self-Service > Test env):
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
