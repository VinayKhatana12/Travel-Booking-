# Optional overrides — the defaults work out of the box with `npm run dev`.

# Full API base URL. Leave unset in development: the Vite dev server proxies
# /api -> http://localhost:5000, which keeps the JWT cookie first-party.
# VITE_API_URL=http://localhost:5000/api

# Change where the dev proxy points if your API runs on another port.
# VITE_API_PROXY=http://localhost:5000
